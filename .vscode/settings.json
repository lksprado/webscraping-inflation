{
  // Python settings
    "python.analysis.autoSearchPaths": true,
    "python.analysis.diagnosticSeverityOverrides": {
    "reportMissingImports": "none"
    },
    "python.analysis.extraPaths": [
        "${workspaceFolder}/src"
    ],
    "python.envFile": "${workspaceFolder}/.env",
    "python.terminal.activateEnvironment": true,
    "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",

    // Test settings
    "python.testing.pytestEnabled": true,
    "python.testing.unittestEnabled": false,
    "python.testing.cwd": "${workspaceFolder}/tests",
    "python.testing.pytestPath": "${workspaceFolder}/.venv/bin/pytest",
    "python.testing.autoTestDiscoverOnSaveEnabled": true,
    "workbench.colorCustomizations": {
      "activityBar.activeBackground": "#d0eeb5",
      "activityBar.background": "#d0eeb5",
      "activityBar.foreground": "#15202b",
      "activityBar.inactiveForeground": "#15202b99",
      "activityBarBadge.background": "#639cdb",
      "activityBarBadge.foreground": "#15202b",
      "commandCenter.border": "#15202b99",
      "editorGroup.border": "#d0eeb5",
      "panel.border": "#d0eeb5",
      "sash.hoverBorder": "#d0eeb5",
      "sideBar.border": "#d0eeb5",
      "statusBar.background": "#b5e48c",
      "statusBar.border": "#b5e48c",
      "statusBar.debuggingBackground": "#bb8ce4",
      "statusBar.debuggingBorder": "#bb8ce4",
      "statusBar.debuggingForeground": "#15202b",
      "statusBar.foreground": "#15202b",
      "statusBarItem.hoverBackground": "#9ada63",
      "statusBarItem.remoteBackground": "#b5e48c",
      "statusBarItem.remoteForeground": "#15202b",
      "tab.activeBorder": "#d0eeb5",
      "titleBar.activeBackground": "#b5e48c",
      "titleBar.activeForeground": "#15202b",
      "titleBar.border": "#b5e48c",
      "titleBar.inactiveBackground": "#b5e48c99",
      "titleBar.inactiveForeground": "#15202b99"
    },
    "peacock.color": "#b5e48c"
}